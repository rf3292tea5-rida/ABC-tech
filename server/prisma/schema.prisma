generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model EnrollmentSubmission {
  id            String   @id @default(uuid())
  fullName      String
  email         String
  phone         String
  careerPath    String
  experience    String
  createdAt     DateTime @default(now())
}